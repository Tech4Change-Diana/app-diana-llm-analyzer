# DIANA — gateway de inteligência (app-diana-llm-analyzer)
# Copie para `.env` e ajuste. NUNCA versione o `.env`.

# --- modo do analyzer ---
# oci  = OCI Generative AI real (com fallback automático para o mock)
# mock = força o mock/local (útil em CI/dev sem credenciais) — é o DEFAULT
ANALYZER_MODE=mock

# --- OCI Generative AI ---
OCI_COMPARTMENT_OCID=
# On-demand: informe o modelo. Dedicado: informe o endpoint (um dos dois).
OCI_GENAI_MODEL_ID=
OCI_GENAI_ENDPOINT_ID=
OCI_REGION=sa-saopaulo-1

# Ambiente reportado em ModelMetadata.environment: development | production
# (no fallback o resultado é sempre carimbado como "mock").
OCI_GENAI_ENV=development

# --- autenticação OCI ---
# config_file (dev local) | instance_principal | resource_principal (produção)
OCI_AUTH=config_file
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT

# --- inferência ---
OCI_GENAI_TEMPERATURE=0.1
OCI_GENAI_MAX_TOKENS=1024
# Timeout (ms) e nº de retries de schema antes do fallback para o mock.
OCI_REQUEST_TIMEOUT_MS=20000
OCI_MAX_RETRIES=1

# --- logging ---
LOG_LEVEL=info
